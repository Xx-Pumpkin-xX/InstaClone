rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function owner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    //username chữ thường, số, dấu gạch dưới
    //dài 3–30 ký tự
    function validUsername(username) {
      return username is string
      && username.matches('^[a-z0-9_.]{3,30}$');
    }

    function validUser(data) {
      return data.keys().hasAll
      ([
        'username', 'displayName', 'bio', 'avatarUrl',
        'postCount', 'followerCount', 'followingCount',
        'createdAt'
      ])

      && data.keys().hasOnly
      ([
        'username', 'displayName', 'bio', 'avatarUrl',
        'postCount', 'followerCount', 'followingCount',
        'createdAt', 'postMutationId'
      ])

      && validUsername(data.username)
      && data.displayName is string
      && data.displayName.size() <= 30
      && data.bio is string
      && data.bio.size() <= 150
      && data.avatarUrl is string
      && data.postCount is int
      && data.followerCount is int
      && data.followingCount is int
      && data.postCount >= 0
      && data.followerCount >= 0
      && data.followingCount >= 0
      && (!('postMutationId' in data) || data.postMutationId is string)
      && data.createdAt is timestamp;
    }

    match /users/{uid} {
      allow read: if signedIn();

      allow create: if owner(uid)
      && validUser(request.resource.data)
      && request.resource.data.postCount == 0
      && request.resource.data.followerCount == 0
      && request.resource.data.followingCount == 0
      && request.resource.data.createdAt == request.time
      && getAfter(
        /databases/$(database)/documents/usernames/$(request.resource.data.username)
      ).data.uid == uid;

      //Chỉ nhánh chỉnh sửa hồ sơ
      //Các nhánh counter sẽ bổ sung riêng
      allow update: if owner(uid)
      && validUser(request.resource.data)
      && (
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['displayName', 'bio', 'avatarUrl'])
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['postCount', 'postMutationId'])
          && request.resource.data.postMutationId is string
          && request.resource.data.postCount == resource.data.postCount + 1
          && existsAfter(
            /databases/$(database)/documents/posts/$(request.resource.data.postMutationId)
          )
          && getAfter(
            /databases/$(database)/documents/posts/$(request.resource.data.postMutationId)
          ).data.authorId == uid
        )
        ||
        (
          request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(['postCount', 'postMutationId'])
          && request.resource.data.postMutationId is string
          && request.resource.data.postCount == resource.data.postCount - 1
          && exists(
            /databases/$(database)/documents/posts/$(request.resource.data.postMutationId)
          )
          && get(
            /databases/$(database)/documents/posts/$(request.resource.data.postMutationId)
          ).data.authorId == uid
          && !existsAfter(
            /databases/$(database)/documents/posts/$(request.resource.data.postMutationId)
          )
        )
      );

      allow delete: if false;
    }

    match /usernames/{username} {
      allow read: if signedIn();

      allow create: if signedIn()
      && validUsername(username)
      && request.resource.data.keys().hasAll(['uid'])
      && request.resource.data.keys().hasOnly(['uid'])
      && request.resource.data.uid is string
      && request.resource.data.uid == request.auth.uid
      && getAfter(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.username == username;

      allow update, delete: if false;
    }

    match /posts/{postId} {
      allow read: if signedIn();

      allow create: if signedIn()
      && request.resource.data.keys().hasAll([
        'authorId', 'authorUsername', 'authorAvatarUrl', 'imageUrl',
        'imagePath', 'caption', 'likeCount', 'commentCount', 'createdAt'
      ])
      && request.resource.data.keys().hasOnly([
        'authorId', 'authorUsername', 'authorAvatarUrl', 'imageUrl',
        'imagePath', 'caption', 'likeCount', 'commentCount', 'createdAt'
      ])
      && owner(request.resource.data.authorId)
      && request.resource.data.authorUsername is string
      && request.resource.data.authorAvatarUrl is string
      && request.resource.data.imageUrl is string
      && request.resource.data.imagePath is string
      && request.resource.data.imagePath.matches(
        '^images/posts/' + request.auth.uid + '/[A-Za-z0-9_-]+[.]jpg$'
      )
      && request.resource.data.caption is string
      && request.resource.data.caption.size() <= 2200
      && request.resource.data.likeCount == 0
      && request.resource.data.commentCount == 0
      && request.resource.data.createdAt == request.time
      && getAfter(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.postCount
        == get(
          /databases/$(database)/documents/users/$(request.auth.uid)
        ).data.postCount + 1
      && getAfter(
        /databases/$(database)/documents/users/$(request.auth.uid)
      ).data.postMutationId == postId;

      allow delete: if owner(resource.data.authorId)
      && exists(
        /databases/$(database)/documents/users/$(resource.data.authorId)
      )
      && getAfter(
        /databases/$(database)/documents/users/$(resource.data.authorId)
      ).data.postCount
        == get(
          /databases/$(database)/documents/users/$(resource.data.authorId)
        ).data.postCount - 1
      && getAfter(
        /databases/$(database)/documents/users/$(resource.data.authorId)
      ).data.postMutationId == postId;

      allow update: if owner(resource.data.authorId)
      && request.resource.data.authorId == resource.data.authorId
      && request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['authorAvatarUrl'])
      && request.resource.data.authorAvatarUrl is string;

      match /likes/{likeId} {
        allow read, delete: if signedIn()
        && owner(get(
          /databases/$(database)/documents/posts/$(postId)
        ).data.authorId);
      }

      match /comments/{commentId} {
        allow read, delete: if signedIn()
        && owner(get(
          /databases/$(database)/documents/posts/$(postId)
        ).data.authorId);
      }
    }
  }
}